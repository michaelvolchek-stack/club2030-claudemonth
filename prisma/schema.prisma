generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// status: DRAFT | ACTIVE | COMPLETED | CANCELLED
// priority: URGENT | HIGH | MEDIUM | LOW
model Task {
  id            String   @id @default(cuid())
  title         String
  description   String?
  status        String   @default("ACTIVE")
  priority      String   @default("MEDIUM")
  dueDate       DateTime?
  dueHasTime    Boolean  @default(false)
  plannedDate   DateTime?
  isRecurring   Boolean  @default(false)
  recurringRule String?
  projectId     String?
  parentTaskId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project        Project?           @relation(fields: [projectId], references: [id])
  parentTask     Task?              @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks       Task[]             @relation("SubTasks")
  checklistItems SubTask[]
  tags           TaskTag[]
  history        TaskHistory[]
  reminders      WhatsAppReminder[]
  incomingLinks  WhatsAppIncoming[]
}

model Project {
  id        String    @id @default(cuid())
  name      String
  color     String?
  parentId  String?
  createdAt DateTime  @default(now())

  parent   Project?  @relation("SubProjects", fields: [parentId], references: [id])
  children Project[] @relation("SubProjects")
  tasks    Task[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String?
  tasks TaskTag[]
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model SubTask {
  id        String  @id @default(cuid())
  taskId    String
  title     String
  completed Boolean @default(false)
  order     Int     @default(0)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskHistory {
  id        String   @id @default(cuid())
  taskId    String
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Phase 2 — schema ready, not implemented
// status: PENDING | SENT | FAILED
model WhatsAppReminder {
  id          String    @id @default(cuid())
  taskId      String
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("PENDING")
  instanceId  String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Phase 2 — schema ready, not implemented
model WhatsAppIncoming {
  id          String    @id @default(cuid())
  fromNumber  String
  body        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id])
}
